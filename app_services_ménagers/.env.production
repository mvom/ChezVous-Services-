APP_NAME=API Services Menagers
APP_VERSION=0.1.0
APP_ENV=production
APP_DEBUG=false
AUTO_MIGRATE=true
LOG_LEVEL=INFO
LOG_JSON=true
LOG_TO_FILE=true
LOG_FILE_PATH=/app/logs/app.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=10
ENABLE_REQUEST_LOGGING=true
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
CORS_ORIGINS=https://your-domain.example
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
DATABASE_URL=postgresql+psycopg://user:password@db:5432/services_menagers
JWT_SECRET_KEY=replace-with-a-strong-production-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30
